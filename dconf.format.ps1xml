<?xml version="1.0" encoding="utf-8" ?>

<Configuration>
  <ViewDefinitions>
    <View>
      <Name>TableView</Name>
      <ViewSelectedBy>
        <TypeName>Dconf.NodeInfo</TypeName>
      </ViewSelectedBy>

      <GroupBy>
        <Label>Path</Label>
        <ScriptBlock>
          "/" +
          ($_.PSParentPath -replace "^$([regex]::Escape($_.PSProvider))::" -replace "^/") +
          "/"
        </ScriptBlock>
      </GroupBy>

      <TableControl>
        <AutoSize/>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Type</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Path</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Summary</Label>
          </TableColumnHeader>
        </TableHeaders>

        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>$_.GetType().Name -replace 'Info$'</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>PathFragment</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_ -is [Dconf.SchemaPartInfo])
                  {
                      ($_.Path -replace "/", ".") + "..."
                  }
                  else
                  {
                      $_.Name
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Summary</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
